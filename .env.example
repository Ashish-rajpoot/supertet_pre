# Port the server listens on
PORT=8080

# Secret used to sign account/login tokens (JWT). Use a long random string in production.
JWT_SECRET=change-me-to-a-long-random-string

# Comma-separated emails that are promoted to admin the first time they sign in.
# This is how you can create extra admins without touching MongoDB by hand.
# ADMIN_EMAILS=you@example.com,yourwife@example.com

# Default admin account created automatically on server start (and by `npm run seed`).
# DEV ONLY - change (or remove by setting ADMIN_EMAIL empty) before going to production.
# ADMIN_EMAIL=admin@gmail.com
# ADMIN_PASSWORD=admin@123

# MongoDB connection string
# Local MongoDB:
# MONGODB_URI=mongodb://127.0.0.1:27017/supertet-prep

# Or MongoDB Atlas (cloud, free tier):
# Replace <db_password> with your Atlas database user password:
MONGODB_URI=mongodb+srv://ashish142:<db_password>@cluster0.3abiu.mongodb.net/supertet-prep?retryWrites=true&w=majority&appName=Cluster0
